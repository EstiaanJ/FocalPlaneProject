# Cargo workspace output and member-local lockfiles. The root lockfile is the
# reproducible dependency record for the complete workspace.
target/
/crates/*/Cargo.lock

# Obsidian's local UI state is not project documentation.
.obsidian/

# Images are local assets and are not committed.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.tif
*.tiff
*.bmp
*.ico
*.svg

# Large test inputs are local by default.
/test-image/*
!/test-image/README.md
